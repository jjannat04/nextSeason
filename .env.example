# Read these into your shell; this project does not automatically load .env files.
NEXTSEASON_DEBUG=
NEXTSEASON_ALLOW_FIXTURES=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
NEXTSEASON_SECURE_SSL_REDIRECT=
NEXTSEASON_HSTS_SECONDS=
NEXTSEASON_TRUST_PROXY_HEADERS=
# NEXTSEASON_CACHE_DIR=B:/persistent/next-season-power-cache
# NEXTSEASON_ENV_CACHE_DIR=B:/persistent/next-season-satellite-cache
# Supply locally through the backend environment; never commit real tokens.
# AppEEARS API token (different from an Earthdata bearer token):
NASA_APPEEARS_TOKEN=
# Earthdata Login bearer token for Harmony:
NASA_EARTHDATA_TOKEN=
EARTHDATA_TOKEN=
